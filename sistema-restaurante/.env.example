APP_NAME="Sistema de Restaurante"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/La_Paz

VITE_APP_NAME="${APP_NAME}"

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base de datos ventas_db (docker compose en la raíz del repo)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=13311
DB_DATABASE=ventas_db
DB_USERNAME=root
DB_PASSWORD=ventas123

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log

# «Desarrollado por …» en el inicio de sesión y al pie del menú. Vacío = no
# se muestra (para el cliente que no lo quiera).
# DESARROLLADO_POR=InnovaDevs

# Visor de errores del desarrollador: /_errores?clave=ESTA_CLAVE. No está en
# ningún menú y no depende de usuarios: solo entra quien tiene la clave. Vacía,
# el visor no existe (404). Mínimo 24 caracteres; generar una con:
#   php -r "echo bin2hex(random_bytes(20));"
CLAVE_DESARROLLADOR=
