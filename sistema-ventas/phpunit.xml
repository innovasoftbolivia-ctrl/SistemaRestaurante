<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Las pruebas ejercitan también la facturación y el IVA, aunque en pantalla estén ocultos. -->
        <env name="MOSTRAR_FACTURACION" value="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
          El esquema usa columnas generadas, ENUM y triggers de MySQL, así que
          las pruebas corren contra una copia real de la base, no contra SQLite.
          La base de pruebas se crea una sola vez con el comando documentado en
          el README (sección "Pruebas"), que carga docs/sql sobre ventas_db_test.
          Cada prueba corre dentro de una transacción que se revierte al final.

          `force="true"`: el contenedor de la app ya trae DB_HOST=mysql y
          DB_DATABASE=ventas_db como variables de entorno reales (las usa en
          marcha normal). Sin `force`, PHPUnit no pisa una variable que ya
          existe, así que estas de aquí perdían en silencio y las pruebas
          terminaban corriendo —y escribiendo— sobre la base de desarrollo en
          vez de la de pruebas. Correr `php artisan test` desde DENTRO del
          contenedor sigue sin funcionar (127.0.0.1:13310 no es alcanzable
          ahí), pero ahora falla con un error de conexión en vez de ensuciar
          `ventas_db` sin avisar. Desde el host sí conecta: por eso las
          pruebas se corren con el PHP del host, como documenta el README.
        -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="13310" force="true"/>
        <env name="DB_DATABASE" value="ventas_db_test" force="true"/>
        <env name="DB_USERNAME" value="root" force="true"/>
        <env name="DB_PASSWORD" value="ventas123" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
