# Plantilla de configuración del Sistema de Ventas cuando corre DENTRO de Docker.
#
# docker-compose.yml lo pasa como `env_file` a los servicios app y vite, así que
# estas variables llegan al contenedor como variables de entorno reales. Laravel
# carga Dotenv en modo inmutable, de modo que mandan sobre lo que diga el .env
# del bind mount —que sigue siendo el bueno para trabajar sin Docker, con la
# base en 127.0.0.1:13310.
#
# La diferencia esencial son dos líneas: DB_HOST=mysql y DB_PORT=3306, porque
# dentro de la red de compose se llega al contenedor por su nombre y por el
# puerto interno, no por el publicado en el host.
#
# CÓMO USAR ESTA PLANTILLA (una sola vez, por instalación):
#
#   cp .env.docker.example .env.docker
#
# y completa APP_KEY y DB_PASSWORD antes de `docker compose up`:
#
#   APP_KEY:      php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
#   DB_PASSWORD:  cualquier contraseña propia — distinta en cada instalación
#                 real, para que filtrar una no comprometa a las demás. Debe
#                 coincidir con DB_PASSWORD en el .env de la raíz del repo
#                 (ver .env.example junto a docker-compose.yml).
#
# `.env.docker` NO se sube al repositorio (está en .gitignore): cada instalación
# —de desarrollo o de un cliente— tiene su propia clave y su propia contraseña.

APP_NAME="Sistema de Ventas"
# `production` y no `local`: además de ser lo que corresponde, Laravel usa
# este valor para decidir cuándo pedir confirmación antes de un comando
# destructivo (`migrate:fresh`, `db:wipe`). Con `local` los ejecuta sin
# preguntar, que es justo lo que no se quiere en el servidor de un negocio.
APP_ENV=production
APP_KEY=
# En una instalación real (cliente) deja esto en false: con true, un error
# muestra el stack trace completo —rutas del servidor, consultas SQL— a quien
# sea que esté mirando la pantalla en ese momento.
APP_DEBUG=false
APP_URL=http://localhost:8100
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/La_Paz

VITE_APP_NAME="${APP_NAME}"

# "daily" y no "single": un solo storage/logs/laravel.log crece sin límite.
# Con "daily", Laravel rota un archivo por día y borra los de más de 14 (la
# opción LOG_DAILY_DAYS, con ese valor por omisión) — sin esto, en un
# servidor real el disco se llena solo, tarde o temprano.
LOG_CHANNEL=daily
# `warning` y no `debug`: en producción, `debug` escribe cada consulta y cada
# paso del framework. Llena el disco mucho más rápido de lo que uno espera
# —y con el disco lleno se detiene MySQL y fallan los respaldos— y deja en
# el log datos que no tienen por qué quedar escritos. Lo que de verdad hay
# que mirar cuando algo va mal son los avisos y los errores; el registro de
# quién hizo cada operación no vive aquí, vive en la tabla `auditoria`.
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ventas_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# En true si el servidor queda detrás de HTTPS (ver README, "Nueva instalación"):
# el navegador deja de mandar la cookie de sesión por HTTP plano, así que un
# atacante en la misma red no puede robarla espiando el tráfico. En false
# mientras el sitio solo se sirva por HTTP, o el login deja de funcionar.
SESSION_SECURE_COOKIE=false

# Vacío mientras nginx reciba las visitas directo (como en desarrollo). Si el
# servidor real queda detrás de un proxy (el mismo del paso de HTTPS): la IP
# del proxy, separada por comas si son varias, o "*" si es de confianza total
# (un balanceador en la misma red privada, por ejemplo). Sin esto detrás de un
# proxy, la bitácora registra la IP del proxy en vez de la del cliente.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log

# --- Cobro por QR ---------------------------------------------------------
#
# «simulado» genera un QR real, escaneable y con el importe puesto, pero SIN
# banco detrás: el pago no llega solo, lo confirma el cajero desde la pantalla,
# que además lo avisa con todas las letras. Es lo correcto mientras no haya
# convenio — y a propósito no se paga solo, para que nadie confunda la demo
# con un cobro de verdad.
#
# Con Banco Económico se pone «baneco» y se completan las QR_BANECO_* de abajo.
# Para otro banco, «banco» y las tres variables genéricas; lo que hay que
# pedirle está anotado en la cabecera de app/Services/Qr/QrBanco.php.
QR_PASARELA=simulado

# Una segunda carpeta, FUERA del disco del servidor, donde se copia cada
# respaldo: un disco externo, una carpeta sincronizada con la nube o una
# unidad de red (en Docker, montada como volumen). Vacía = solo en el servidor.
RESPALDOS_COPIA=

# Cuánto vale un QR antes de vencerse, y cada cuánto el mostrador le pregunta
# al banco si ya pagaron. Bajar el segundo hace la espera más viva pero
# castiga al banco con más llamadas.
QR_MINUTOS_VIGENCIA=10
QR_SEGUNDOS_CONSULTA=4

# Solo con QR_PASARELA=banco. Vacías mientras se use el simulador.
#
# QR_SECRETO_WEBHOOK es el que firma los avisos de pago del banco. Ese aviso
# entra sin sesión y sin CSRF —el banco no inicia sesión—, así que la firma es
# su única defensa: SIN ESTE SECRETO SE RECHAZA TODO AVISO. Falla cerrado a
# propósito; dejarlo vacío nunca abre la puerta, solo apaga el webhook.
QR_URL_BASE=
QR_TOKEN=
QR_SECRETO_WEBHOOK=

# Solo con QR_PASARELA=baneco. Los entrega Banco Económico al habilitar
# «BEC QR Connect». NUNCA van al repositorio.
# La URL por omisión es la de certificación; en producción el banco da otra.
# El aviso de pago se publica en /api/qrsimple/notifyPaymentQR: no trae firma,
# así que el sistema lo usa solo para consultar al banco, nunca lo cree.
QR_BANECO_URL=https://apimktdesa.baneco.com.bo/ApiGateway
QR_BANECO_USUARIO=
QR_BANECO_PASSWORD=
QR_BANECO_LLAVE=
QR_BANECO_CUENTA=
QR_BANECO_SUCURSAL=
QR_BANECO_PREFIJO=SV
