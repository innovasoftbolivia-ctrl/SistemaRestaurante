# Variables que usa docker-compose.yml del Sistema de Ventas (no las de Laravel:
# esas van en sistema-ventas/.env.docker).
#
# Copia este archivo a `.env` en esta misma carpeta y pon una contraseña propia.
# Sin este archivo, docker-compose usa "ventas123" como respaldo (ver el `:-`
# en docker-compose.yml) para no romper una instalación de desarrollo que ya
# existía sin este archivo — pero una instalación real (cliente) SÍ debería
# tener el suyo, distinto, para que filtrar una contraseña no comprometa a las
# demás instalaciones.
#
# Debe coincidir con DB_PASSWORD en sistema-ventas/.env.docker.
DB_PASSWORD=ventas123

# Solo producción (docker-compose.prod.yml): la contraseña de `ventas_app`, la
# cuenta con permisos mínimos con la que se conecta la aplicación. Se crea al
# primer arranque de la base; va también en DB_PASSWORD de
# sistema-ventas/.env.docker, junto con DB_USERNAME=ventas_app.
DB_APP_PASSWORD=

# Solo producción. Puerto por el que se entra al sistema. En el local, las cajas
# usan http://IP-del-servidor:8100. Con un proxy HTTPS en este mismo servidor:
# APP_PUERTO=127.0.0.1:8100, para que nadie entre sin pasar por el HTTPS.
# APP_PUERTO=8100

# Solo producción. La carpeta del SERVIDOR donde va la copia externa de cada
# respaldo (disco USB montado, carpeta sincronizada con la nube). Tiene que ser
# escribible por el usuario 82 (www-data del contenedor):
#   sudo chown 82:82 /media/usb/respaldos-ventas
# y en sistema-ventas/.env.docker: RESPALDOS_COPIA=/respaldos-copia
# RESPALDOS_COPIA_SERVIDOR=/media/usb/respaldos-ventas
